# OpenPapers MCP — example configuration. Copy to `.env` and edit.
# `.env` is git-ignored and never leaves your machine.

# Your email is sent only as `mailto=` to OpenAlex/Unpaywall and in the
# User-Agent to CrossRef, to participate in their "polite pool" (higher rate
# limits). It is not transmitted to any third party.
#
# Set POLITE_POOL=0 to withhold your email entirely (privacy mode) at the
# cost of stricter rate limits.
CONTACT_EMAIL=your-email@example.com
POLITE_POOL=1

# Where downloaded PDFs are stored.
PDF_DIR=./pdfs

# HTTP tuning
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
PDF_MAX_BYTES=104857600   # 100 MB

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional API base overrides:
# OPENALEX_BASE=https://api.openalex.org
# CROSSREF_BASE=https://api.crossref.org
# UNPAYWALL_BASE=https://api.unpaywall.org
